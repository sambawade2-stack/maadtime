# ============================================
# MAADTIME — Configuration Environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================

# Django
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com

# PostgreSQL
POSTGRES_DB=maadtime
POSTGRES_USER=maadtime
POSTGRES_PASSWORD=mot-de-passe-securise
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://:mot-de-passe-redis@redis:6379/0
REDIS_PASSWORD=mot-de-passe-redis

# CORS
CORS_ALLOWED_ORIGINS=https://votre-domaine.com

# Frontend
NEXT_PUBLIC_API_URL=https://votre-domaine.com/api

# SSL (pour Nginx en production)
SECURE_SSL_REDIRECT=True
